foo <- LOAD "foo"

caseA <- SELECT(?x, <http://www.w3.org/2002/07/owl#sameAs>, ?z)
         WHERE MATCH(?x, <http://www.w3.org/2002/07/owl#sameAs>, ?y) IN foo
         AND MATCH(?z, <http://www.w3.org/2002/07/owl#sameAs>, ?y) IN foo

caseB <- SELECT(?x, <http://www.w3.org/2002/07/owl#sameAs>, ?z)
         WHERE MATCH(?x, <http://www.w3.org/2002/07/owl#sameAs>, ?y) IN foo
         AND MATCH(?y, <http://www.w3.org/2002/07/owl#sameAs>, ?z) IN foo

result <- caseA UNION caseB
PRINT result